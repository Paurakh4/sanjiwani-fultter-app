# Copy to /opt/bsp/push-sender/env, then chown bsp:bsp and chmod 600.
# The sender signs in as a superuser to read the notice queue and the device
# tokens, both of which are closed to patients by design.

BSP_PB_URL=http://127.0.0.1:8090
BSP_PB_EMAIL=admin@sanjiwani.com.np
BSP_PB_PASS=
BSP_GOOGLE_CREDENTIALS=/opt/bsp/push-sender/sa.json
BSP_POLL_SECONDS=20
