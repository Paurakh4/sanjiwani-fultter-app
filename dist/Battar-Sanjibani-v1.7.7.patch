+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Row(
+                      children: [
+                        SizedBox(
+                          width: 44,
+                          height: 44,
+                          child: Checkbox(
+                            value: _acceptedTerms,
+                            onChanged: (value) {
+                              setState(() => _acceptedTerms = value ?? false);
+                              field.didChange(value ?? false);
+                            },
+                          ),
+                        ),
+                        Expanded(
+                          child: Wrap(
+                            crossAxisAlignment: WrapCrossAlignment.center,
+                            children: [
+                              Text(l10n.termsPrefix),
+                              TextButton(
+                                style: TextButton.styleFrom(
+                                  padding: const EdgeInsets.symmetric(
+                                    horizontal: 4,
+                                  ),
+                                  minimumSize: const Size(0, 40),
+                                ),
+                                onPressed: _showTerms,
+                                child: Text(l10n.termsLink),
+                              ),
+                            ],
+                          ),
+                        ),
+                      ],
+                    ),
+                    if (field.hasError)
+                      Padding(
+                        padding: const EdgeInsets.only(left: 44),
+                        child: Text(
+                          field.errorText ?? '',
+                          style: theme.textTheme.bodySmall?.copyWith(
+                            color: scheme.error,
+                          ),
+                        ),
+                      ),
+                  ],
+                ),
+              ),
+              const SizedBox(height: 22),
+              SizedBox(
+                width: double.infinity,
+                child: FilledButton(
+                  onPressed: _submit,
+                  child: Text(l10n.createAccount),
+                ),
+              ),
+              const SizedBox(height: 12),
+              Center(
+                child: Row(
+                  mainAxisSize: MainAxisSize.min,
+                  children: [
+                    Text(
+                      l10n.haveAccountPrompt,
+                      style: theme.textTheme.bodyMedium?.copyWith(
+                        color: scheme.onSurfaceVariant,
+                      ),
+                    ),
+                    TextButton(
+                      onPressed: () => Navigator.of(context).pushReplacement(
+                        MaterialPageRoute<void>(
+                          builder: (_) => const LoginScreen(),
+                        ),
+                      ),
+                      child: Text(l10n.signIn),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  InputDecoration _passwordDecoration(
+    ColorScheme scheme,
+    L10n l10n, {
+    String? hint,
+  }) {
+    return InputDecoration(
+      hintText: hint ?? l10n.passwordHint,
+      prefixIcon: Center(
+        widthFactor: 1,
+        child: CoolSvgIcon('lock-round', size: 22, color: scheme.onSurfaceVariant),
+      ),
+      suffixIcon: IconButton(
+        onPressed: () => setState(() => _obscure = !_obscure),
+        icon: CoolSvgIcon(
+          _obscure ? 'eye-round' : 'eye-off-round',
+          size: 22,
+          color: scheme.onSurfaceVariant,
+        ),
+      ),
+    );
+  }
+}
