@@ -0,0 +1,88 @@
+import '../data/demo_data.dart';
+import '../models.dart';
+import 'clinic.dart';
+import 'saturday_schedule.dart';
+
+DateTime slotDateTime(DateTime date, String slot) {
+  final parts = slot.split(':');
+  return DateTime(
+    date.year,
+    date.month,
+    date.day,
+    int.parse(parts[0]),
+    int.parse(parts[1]),
+  );
+}
+
+/// Single source of truth for whether a specialist slot can be booked.
+/// Layers real bookings on top of the stable demo "other patients" occupancy.
+bool isSlotBookable({
+  required Doctor doctor,
+  required DateTime date,
+  required String slot,
+  required List<Appointment> appointments,
+  String? excludingAppointmentId,
+  DateTime? now,
+}) {
+  if (!doctorScheduledOn(doctor, date)) return false;
+
+  final parts = slot.split(':');
+  final hour = int.parse(parts[0]);
+  if (hour >= Clinic.closeHour) return false;
+  if (doctor.startTime != null && slot.compareTo(doctor.startTime!) < 0) {
+    return false;
+  }
+  if (doctor.endTime != null && slot.compareTo(doctor.endTime!) >= 0) {
+    return false;
+  }
+
+  final current = now ?? DateTime.now();
+  final day = dateOnly(date);
+  if (day == dateOnly(current)) {
+    final slotTime = slotDateTime(date, slot);
+    if (slotTime.isBefore(current.add(const Duration(minutes: 30)))) {
+      return false;
+    }
+  }
+
+  for (final appointment in appointments) {
+    if (appointment.status != AppointmentStatus.booked) continue;
+    if (appointment.id == excludingAppointmentId) continue;
+    if (appointment.doctorId != doctor.id) continue;
+    if (dateOnly(appointment.date) != day) continue;
+    if (appointment.slot == slot) return false;
+  }
+
+  final seed = '${doctor.id}-${date.year}-${date.month}-${date.day}-$slot';
+  var hash = 7;
+  for (final code in seed.codeUnits) {
+    hash = (hash * 31 + code) & 0x7fffffff;
+  }
+  return hash % 6 != 0;
+}
+
+bool hasAnyBookableSlot({
+  required Doctor doctor,
+  required DateTime date,
+  required List<Appointment> appointments,
+  String? excludingAppointmentId,
+  DateTime? now,
+}) {
+  if (!doctorScheduledOn(doctor, date)) return false;
+  for (final shift in SlotShift.values) {
+    if (!doctor.shifts.contains(shift)) continue;
+    for (final slot in clinicSlots[shift] ?? const <String>[]) {
+      if (isSlotBookable(
+        doctor: doctor,
+        date: date,
+        slot: slot,
+        appointments: appointments,
+        excludingAppointmentId: excludingAppointmentId,
+        now: now,
+      )) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
