+          physics: const AlwaysScrollableScrollPhysics(),
+          padding: const EdgeInsets.fromLTRB(
+            AppTokens.gutter,
+            4,
+            AppTokens.gutter,
+            40,
+          ),
+          children: [
+            AppCard(
+              onTap: doctor == null
+                  ? null
+                  : () => Navigator.of(context).push(
+                      MaterialPageRoute<void>(
+                        builder: (_) => DoctorDetailScreen(doctor: doctor),
+                      ),
+                    ),
+              child: Row(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  if (doctor != null)
+                    DoctorAvatar(doctor: doctor, size: 56)
+                  else
+                    TonalIcon(
+                      icon: CoolIcons.stethoscope,
+                      size: 56,
+                      iconSize: 26,
+                    ),
+                  const SizedBox(width: 14),
+                  Expanded(
+                    child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      children: [
+                        Text(
+                          doctorName,
+                          maxLines: 2,
+                          overflow: TextOverflow.ellipsis,
+                          style: theme.textTheme.titleMedium?.copyWith(
+                            fontSize: 16,
+                          ),
+                        ),
+                        const SizedBox(height: 2),
+                        Text(
+                          department.displayName,
+                          maxLines: 2,
+                          overflow: TextOverflow.ellipsis,
+                          style: theme.textTheme.bodySmall?.copyWith(
+                            color: scheme.onSurfaceVariant,
+                          ),
+                        ),
+                        const SizedBox(height: 8),
+                        StatusPill(
+                          label: label,
+                          background: background,
+                          foreground: foreground,
+                        ),
+                      ],
+                    ),
+                  ),
+                  if (doctor != null)
+                    Icon(
+                      CoolIcons.caretRight,
+                      size: 18,
+                      color: scheme.onSurfaceVariant,
+                    ),
+                ],
+              ),
+            ),
+            const SizedBox(height: 16),
+            Container(
+              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
+              decoration: BoxDecoration(
+                color: dateBackground,
+                borderRadius: BorderRadius.circular(AppTokens.radiusInner),
+              ),
+              child: Row(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Icon(
+                    CoolIcons.calendarBlank,
+                    size: 20,
+                    color: dateForeground,
+                  ),
+                  const SizedBox(width: 12),
+                  Expanded(
+                    child: Column(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      children: [
+                        Text(
+                          l10n.weekdayBoth(appointment.date),
+                          style: theme.textTheme.labelMedium?.copyWith(
+                            color: dateForeground,
+                            fontWeight: FontWeight.w600,
+                          ),
+                        ),
+                        const SizedBox(height: 2),
+                        Text(
+                          l10n.dateBoth(appointment.date),
+                          style: theme.textTheme.bodySmall?.copyWith(
+                            color: dateForeground,
+                            height: 1.45,
+                          ),
+                        ),
+                      ],
+                    ),
+                  ),
+                  const SizedBox(width: 12),
+                  Column(
+                    crossAxisAlignment: CrossAxisAlignment.end,
+                    children: [
+                      Icon(
+                        CoolIcons.clock,
+                        size: 17,
+                        color: dateForeground,
+                      ),
+                      const SizedBox(height: 3),
+                      Text(
+                        l10n.appointmentTime(appointment.slot),
+                        style: theme.textTheme.labelMedium?.copyWith(
+                          color: dateForeground,
+                          fontWeight: FontWeight.w600,
+                        ),
+                      ),
+                    ],
+                  ),
+                ],
+              ),
+            ),
+            const SizedBox(height: 16),
+            AppCard(
+              child: Column(
+                children: [
+                  DetailRow(
+                    label: l10n.patientWord,
+                    value: l10n.personName(appointment.patientName),
+                  ),
+                  const SizedBox(height: 12),
+                  DetailRow(
+                    label: l10n.summaryFee,
+                    value: appointment.fee > 0
+                        ? l10n.money(appointment.fee)
+                        : l10n.payAtClinic,
+                  ),
+                  const SizedBox(height: 12),
+                  DetailRow(
+                    label: l10n.bookedLabel,
+                    value: l10n.dateMedium(appointment.createdAt),
+                  ),
+                ],
+              ),
+            ),
+            const SizedBox(height: 12),
+            Text(
+              l10n.bookingNote,
+              style: theme.textTheme.bodySmall?.copyWith(
+                color: scheme.onSurfaceVariant,
+                height: 1.5,
+              ),
+            ),
+            const SizedBox(height: 24),
+            if (active) ...[
+              FilledButton.icon(
+                onPressed: () async {
+                  final moved = await showRescheduleSheet(context, appointment!);
+                  if (moved == true && context.mounted) {
+                    showAppSnack(context, l10n.rescheduleDoneSnack);
+                  }
+                },
+                icon: const Icon(
+                  CoolIcons.clockCounterClockwise,
+                  size: 18,
+                ),
+                label: Text(l10n.reschedule),
+              ),
+              const SizedBox(height: 10),
+              OutlinedButton.icon(
+                onPressed: () => cancelAppointmentFlow(context, appointment!),
+                style: OutlinedButton.styleFrom(
+                  foregroundColor: scheme.error,
+                  side: BorderSide(color: scheme.error.withValues(alpha: 0.4)),
+                ),
+                icon: const Icon(CoolIcons.x, size: 18),
+                label: Text(l10n.cancelAppointment),
+              ),
+              const SizedBox(height: 10),
+            ],
+            OutlinedButton.icon(
+              onPressed: () => callClinic(context),
+              icon: const Icon(CoolIcons.phoneCall, size: 18),
+              label: Text(l10n.callClinic),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
