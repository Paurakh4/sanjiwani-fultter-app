+/// Shift-grouped slot pills for a doctor on a date, honoring real bookings.
+class BookingSlotPicker extends StatelessWidget {
+  const BookingSlotPicker({
+    super.key,
+    required this.doctor,
+    required this.date,
+    required this.selectedSlot,
+    required this.onSelected,
+    required this.appointments,
+    this.excludingAppointmentId,
+  });
+
+  final Doctor doctor;
+  final DateTime date;
+  final String? selectedSlot;
+  final ValueChanged<String> onSelected;
+  final List<Appointment> appointments;
+  final String? excludingAppointmentId;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final l10n = L10n.of(context);
+    final labels = {
+      SlotShift.morning: l10n.shiftMorning,
+      SlotShift.afternoon: l10n.shiftAfternoon,
+      SlotShift.evening: l10n.shiftEvening,
+    };
+
+    var hasAvailable = false;
+    final groups = <Widget>[];
+    for (final shift in SlotShift.values) {
+      if (!doctor.shifts.contains(shift)) continue;
+      final slots = clinicSlots[shift] ?? const <String>[];
+      if (slots.isEmpty) continue;
+
+      final children = <Widget>[];
+      for (final slot in slots) {
+        if (!isSlotBookable(
+          doctor: doctor,
+          date: date,
+          slot: slot,
+          appointments: appointments,
+          excludingAppointmentId: excludingAppointmentId,
+        )) {
+          continue;
+        }
+        hasAvailable = true;
+        children.add(
+          ChoicePill(
+            label: l10n.timeShort(slot),
+            selected: selectedSlot == slot,
+            onTap: () => onSelected(slot),
+          ),
+        );
+      }
+      if (children.isEmpty) continue;
+
+      groups.add(
+        Padding(
+          padding: const EdgeInsets.only(bottom: 16),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(
+                labels[shift]!,
+                style: theme.textTheme.labelMedium?.copyWith(
+                  color: scheme.onSurfaceVariant,
+                  fontWeight: FontWeight.w600,
+                ),
+              ),
+              const SizedBox(height: 8),
+              Wrap(spacing: 8, runSpacing: 8, children: children),
+            ],
+          ),
+        ),
+      );
+    }
+
+    if (!hasAvailable) {
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          _Note(
+            icon: CoolIcons.calendarX,
+            text: l10n.bookingNoSlots,
+          ),
+          const SizedBox(height: 12),
+          ...groups,
+        ],
+      );
+    }
+    return Column(crossAxisAlignment: CrossAxisAlignment.start, children: groups);
+  }
+}
+
+class _Note extends StatelessWidget {
+  const _Note({required this.icon, required this.text});
+
+  final IconData icon;
+  final String text;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    return Container(
+      padding: const EdgeInsets.all(14),
+      decoration: BoxDecoration(
+        color: scheme.surfaceContainer,
+        borderRadius: BorderRadius.circular(AppTokens.radiusInner),
+      ),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Icon(icon, size: 18, color: scheme.onSurfaceVariant),
+          const SizedBox(width: 10),
+          Expanded(
+            child: Text(
+              text,
+              style: theme.textTheme.bodySmall?.copyWith(
+                color: scheme.onSurfaceVariant,
+                height: 1.5,
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
