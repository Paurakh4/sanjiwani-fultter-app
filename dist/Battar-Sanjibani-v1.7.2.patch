+import 'common.dart';
+
+const double kDateChipWidth = 122.0;
+const double kDateChipGap = 8.0;
+
+bool _sameDay(DateTime a, DateTime b) =>
+    a.year == b.year && a.month == b.month && a.day == b.day;
+
+/// Horizontal rail of the doctor's upcoming Saturdays. Availability reflects
+/// real bookings (and the stable demo occupancy) via [hasAnyBookableSlot].
+class BookingDateRail extends StatelessWidget {
+  const BookingDateRail({
+    super.key,
+    required this.doctor,
+    required this.dates,
+    required this.selectedDate,
+    required this.onSelected,
+    required this.appointments,
+    this.excludingAppointmentId,
+    this.controller,
+  });
+
+  final Doctor doctor;
+  final List<DateTime> dates;
+  final DateTime selectedDate;
+  final ValueChanged<DateTime> onSelected;
+  final List<Appointment> appointments;
+  final String? excludingAppointmentId;
+  final ScrollController? controller;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = L10n.of(context);
+    if (dates.isEmpty) {
+      return _Note(
+        icon: CoolIcons.calendarX,
+        text: l10n.bookingNoDates,
+      );
+    }
+    return SizedBox(
+      height: AppTokens.scaled(context, 88),
+      child: ListView.separated(
+        controller: controller,
+        scrollDirection: Axis.horizontal,
+        itemCount: dates.length,
+        separatorBuilder: (_, _) => const SizedBox(width: kDateChipGap),
+        itemBuilder: (context, index) {
+          final date = dates[index];
+          final enabled = hasAnyBookableSlot(
+            doctor: doctor,
+            date: date,
+            appointments: appointments,
+            excludingAppointmentId: excludingAppointmentId,
+          );
+          return _DateChip(
+            date: date,
+            scheduleLabel: doctor.saturdayGroup == null
+                ? l10n.specialistHoursShort
+                : l10n.saturdayGroupShort(doctor.saturdayGroup!),
+            selected: _sameDay(date, selectedDate),
+            enabled: enabled,
+            disabledHint: l10n.bookingNoSlots,
+            onTap: () => onSelected(date),
+          );
+        },
+      ),
+    );
+  }
+}
+
+class _DateChip extends StatelessWidget {
+  const _DateChip({
+    required this.date,
+    required this.scheduleLabel,
+    required this.selected,
+    required this.enabled,
+    required this.onTap,
